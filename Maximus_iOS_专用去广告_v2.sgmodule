#!name=Maximus iOS 专用去广告 v2
#!desc=针对常用国内 App 的精确广告拦截 + 开屏响应处理。Shadowrocket 专用；避免粗暴屏蔽整站业务域名。
#!author=Maximus / ChatGPT
#!update=1d

[Rule]
# ===== 中国移动 / 中国移动云盘 =====
DOMAIN,ad.mcloud.139.com,REJECT
DOMAIN,jzts.cmpassport.com,REJECT
DOMAIN,ad.10086.cn,REJECT

# ===== 通用广告 SDK：仅拦明确广告主机 =====
DOMAIN-SUFFIX,pangolin-sdk-toutiao.com,REJECT
DOMAIN-SUFFIX,gdt.qq.com,REJECT
DOMAIN,mi.gdt.qq.com,REJECT
DOMAIN,v2mi.gdt.qq.com,REJECT
DOMAIN,win.gdt.qq.com,REJECT
DOMAIN,mobads.baidu.com,REJECT
DOMAIN,afd.baidu.com,REJECT

# ===== 抖音 / 字节广告 =====
DOMAIN,api-access.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api-access.pangolin-sdk-toutiao1.com,REJECT
DOMAIN,api.pangolin-sdk-toutiao.com,REJECT
DOMAIN,api.pangolin-sdk-toutiao1.com,REJECT
DOMAIN,gromore.pangolin-sdk-toutiao.com,REJECT

# ===== 快手：明确广告接口 =====
DOMAIN,open.e.kuaishou.com,REJECT

# ===== 小红书：明确广告素材/接口 =====
DOMAIN,ads-img-al.xhscdn.com,REJECT
DOMAIN,edith.xiaohongshu.com,REJECT
DOMAIN,referee.xiaohongshu.com,REJECT

# ===== 微博 =====
DOMAIN,adstrategy.biz.weibo.com,REJECT
DOMAIN,sdkapp.uve.weibo.com,REJECT
DOMAIN,wbapp.uve.weibo.com,REJECT

# ===== Bilibili =====
DOMAIN,cm.bilibili.com,REJECT

# ===== 淘宝 / 闲鱼 =====
DOMAIN,adash.m.taobao.com,REJECT
DOMAIN,adashx.m.taobao.com,REJECT
DOMAIN,acs.m.taobao.com,REJECT
DOMAIN,acs.m.goofish.com,REJECT

# ===== 京东 =====
DOMAIN,ads-union.jd.com,REJECT
DOMAIN,dsp-x.jd.com,REJECT
DOMAIN,bdsp-x.jd.com,REJECT
DOMAIN,router-app-api.jdcloud.com,REJECT

# ===== 美团 =====
DOMAIN,wmapi.meituan.com,REJECT
DOMAIN,flowplus.meituan.net,REJECT

# ===== 网易云音乐 =====
DOMAIN,iadmusicmat.music.126.net,REJECT
DOMAIN,iadmusicmat.music.com,REJECT
DOMAIN,mobilead.kuwo.com,REJECT

# ===== 12306 =====
DOMAIN,ad.12306.cn,REJECT

# ===== 高德 =====
DOMAIN,optimus-ads.amap.com,REJECT
DOMAIN,amap-aos-info-nogw.amap.com,REJECT

# ===== 通用已知广告素材域 =====
DOMAIN-SUFFIX,adnxs.com,REJECT
DOMAIN-SUFFIX,doubleclick.net,REJECT
DOMAIN-SUFFIX,googlesyndication.com,REJECT

[URL Rewrite]
# 中国移动云盘 / 中国移动广告接口
^https?:\/\/ad\.mcloud\.139\.com\/.+ - reject
^https?:\/\/jzts\.cmpassport\.com\/.+ - reject

# ===== 开屏：使用维护中的 startup.js 响应脚本 =====
^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/list url reject
^https?:\/\/hd\.mina\.mi\.com\/splashscreen\/alert url reject

[Script]
# Bilibili 开屏
bilibili_startup = type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/splash\/list,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js

# 京东/小米系已知开屏接口
jd_startup = type=http-response,pattern=^https?:\/\/hd\.mina\.mi\.com\/splashscreen\/alert,requires-body=1,max-size=0,script-path=https://raw.githubusercontent.com/blackmatrix7/ios_rule_script/master/script/startup/startup.js

[MITM]
hostname = %APPEND% ad.mcloud.139.com,jzts.cmpassport.com,app.bilibili.com,hd.mina.mi.com,adstrategy.biz.weibo.com,sdkapp.uve.weibo.com,wbapp.uve.weibo.com,edith.xiaohongshu.com,acs.m.taobao.com,acs.m.goofish.com,wmapi.meituan.com,ad.12306.cn,optimus-ads.amap.com,mi.gdt.qq.com
